<% if product.persisted? %>
  <div class="card mb-6">
    <div class="card-header">
      <div>
        <h5 class="card-title">Product Story</h5>
        <p class="text-muted mb-0">
          Build the storefront's editorial A+ story with a headline,
          introduction, and three visual chapters.
        </p>
      </div>
    </div>

    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between gap-4">
        <div>
          <strong>Awwwards story module</strong>
          <p class="text-muted mb-0 mt-1">
            Chapter images are paired automatically with this product's
            secondary media.
          </p>
        </div>

        <%= link_to_with_icon(
          'pencil',
          'Edit Product Story',
          spree.edit_admin_metafield_path(
            product.to_param,
            resource_type: product.class.to_s
          ),
          class: 'btn btn-primary',
          data: { action: 'drawer#open', turbo_frame: :drawer }
        ) %>
      </div>
    </div>
  </div>
<% end %>
